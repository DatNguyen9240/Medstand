PORT=3000
API_BASE=https://medtest.bms79.com
N8N_INTERNAL_URL=http://127.0.0.1:5678
CHAT_API_KEY=replace-with-chat-api-key
ADMIN_UPLOAD_KEY=replace-with-a-random-secret

# NOTI-001 deployment/UAT. Scripts refuse databases other than medtest.
TEST_DB_SERVER=127.0.0.1
TEST_DB_PORT=1433
TEST_DB_DATABASE=medtest
TEST_DB_USER=replace-with-test-user
TEST_DB_PASSWORD=replace-with-test-password

# Optional Web Push runtime. Keep the private key on the server only.
WEB_PUSH_SUBJECT=mailto:admin@example.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
NOTIFICATION_PUSH_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# n8n bootstrap. Keep this encryption key stable for the lifetime of the server.
N8N_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
N8N_OWNER_EMAIL=admin@example.com
N8N_OWNER_FIRST_NAME=Medstand
N8N_OWNER_LAST_NAME=Admin
N8N_OWNER_PASSWORD=replace-with-a-strong-password-1A

# n8n credentials generated locally from this ignored .env file.
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_ORGANIZATION_ID=
LLM_API_BASE=https://api.openai.com/v1

MSSQL_SERVER=127.0.0.1
MSSQL_PORT=1433
MSSQL_DATABASE=replace-with-database
MSSQL_USER=replace-with-user
MSSQL_PASSWORD=replace-with-password
MSSQL_DOMAIN=
# Adjust these two flags to match the target SQL Server certificate setup.
MSSQL_TLS=true
MSSQL_ALLOW_UNAUTHORIZED_CERTS=false
MSSQL_CONNECT_TIMEOUT=15000
MSSQL_REQUEST_TIMEOUT=15000
MSSQL_TDS_VERSION=7_4

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USER=
REDIS_DATABASE=0
REDIS_SSL=false
REDIS_DISABLE_TLS_VERIFICATION=false

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# Optional scheduled report. The workflow stays unpublished by default.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
