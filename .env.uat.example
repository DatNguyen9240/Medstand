# Sao chép tệp này thành .env.uat.local. Không commit tệp local.
# Ba workflow staging dùng path UAT riêng, không trùng endpoint production.
UAT_API_EXECUTE_URL=http://localhost:5678/webhook/uat-p005-api-execute
UAT_API_LIST_URL=http://localhost:5678/webhook/uat-p005-api-list-active
UAT_API_CONFIG_URL=http://localhost:5678/webhook/uat-p005-api-get-config

# Token thật; không dùng token production của người dùng ngoài phạm vi UAT.
UAT_MANAGER_TOKEN=
UAT_TDV_TOKEN=
UAT_UNMAPPED_TOKEN=
UAT_NO_SCOPE_TOKEN=

# Danh sách tài khoản và mật khẩu test chỉ điền trong .env.uat.local.
UAT_TEST_PASSWORD=
UAT_MANAGER_USERS=
UAT_TDV_USERS=

# Token cho bộ regression cũ. Có thể tái sử dụng Manager/TDV ở trên cho ADMIN/NORTH.
UAT_ADMIN_TOKEN=
UAT_NORTH_TOKEN=
UAT_CENTRAL_TOKEN=
UAT_SOUTH_TOKEN=
TEST_DB_SERVER=sql.example.internal
TEST_DB_PORT=1433
TEST_DB_DATABASE=medstand_test
TEST_DB_USER=uat_reader
TEST_DB_PASSWORD=replace_me
