# Bản export workflow lấy thẳng từ n8n runtime.
# n8n nhét cả staticData vào export, mà staticData chứa context phiên chạy thật —
# bao gồm token xác thực của người dùng đang đăng nhập. Đã từng lọt 6 token lên
# remote qua reports/runtime-workflows.export.json.
# Cần commit một bản export? Chạy qua bộ lọc trước:
#   node scripts/sanitize_n8n_export.js <file> -o <file.safe.json>
*.export.json
reports/*.export.json
reports/**/*.export.json

# Browser UAT screenshots and runtime summaries may contain business data.
reports/phase1-browser-uat-*/
