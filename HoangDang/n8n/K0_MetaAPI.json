    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (!items || items.length === 0) {\n  return [{ json: { reply: 'Không tìm thấy dữ liệu', status: 'success', count: 0, data: [] } }];\n}\n\n// Gom tất cả các Item của N8N MS SQL node thành 1 mảng JSON Array\nlet payload = items.map(i => i.json);\n\n// Nếu thủ tục SQL chủ động ném lỗi (như lỗi Type không hợp lệ nãy)\nif (payload.length === 1 && (payload[0].code === 1 || payload[0].error)) {\n  return [{ json: { reply: `❌ Lỗi: ${payload[0].msg || payload[0].error}`, status: 'error', data: [] } }];\n}\n\n// Bơm toàn bộ data thành Array\nreturn [{ json: { \n  reply: `Tìm thấy ${payload.length} kết quả.`, \n  status: 'success', \n  count: payload.length, \n  data: payload \n} }];"
