    {
      "parameters": {
        "jsCode": "const headers = $input.item.json.headers || {};\n// nếu không có Authorization nhưng có cookie chứa auth_token -> map vào Authorization\nif (!headers.authorization && headers.cookie) {\n  const m = headers.cookie.match(/(?:^|; )auth_token=([^;]+)/);\n  if (m) headers.authorization = 'Bearer ' + m[1];\n}\nconst method = headers['x-forwarded-method'] || $input.item.json.method || 'POST';\nconst body = $input.item.json.body || {};\nlet apiCode = body.ApiCode || body.StoredProcedure || '';\n\nif (!/^@[a-zA-Z0-9_]+$/.test(apiCode)) {\n  apiCode = '@invalid_code';\n}\n\nconst params = body.params || {};\nconst paramsSafeStr = JSON.stringify(params).replace(/'/g, \"''\");\n\nreturn [{ json: { ...$input.item.json, headers: headers, body: {...body, ApiCode: apiCode}, _paramsSafeStr: paramsSafeStr, _method: method.toUpperCase() } }];"
