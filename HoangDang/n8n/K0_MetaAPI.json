    {
      "parameters": {
        "operation": "executeQuery",
        "query": "DECLARE @ApiCode VARCHAR(100) = '{{ $(\"Check Method Execute\").item.json.body.ApiCode }}';\nDECLARE @ParamsJSON NVARCHAR(MAX) = '{{ $(\"Check Method Execute\").item.json._paramsSafeStr }}';\nDECLARE @SPName NVARCHAR(MAX);\n\nSELECT @SPName = StoredProcedure FROM API_Definition WHERE ApiCode = @ApiCode AND IsActive = 1;\n\nIF @SPName IS NULL\nBEGIN\n    SELECT 1 AS code, 'Missing para or Object not support2-' AS msg FOR JSON PATH;\n    RETURN;\nEND\n\nDECLARE @SQL NVARCHAR(MAX) = N'EXEC ' + QUOTENAME(@SPName) + N' ';\n\nIF @ParamsJSON IS NOT NULL AND @ParamsJSON != '' AND @ParamsJSON != '{}'\nBEGIN\n    SELECT @SQL = @SQL + [key] + N' = N''' + REPLACE(CAST([value] AS NVARCHAR(MAX)), '''', '''''') + N''', '\n    FROM OPENJSON(@ParamsJSON)\n    WHERE [key] LIKE '@%';\n\n    IF RIGHT(@SQL, 2) = ', ' SET @SQL = LEFT(@SQL, LEN(@SQL) - 1);\nEND\n\nEXEC sp_executesql @SQL;"
      },
