    {
      "parameters": {
        "jsCode": "const data = $input.item.json;\nif (data.error || data.status === 'error') {\n  return [{ json: { reply: `❌ ${data.message || data.error}`, status: 'error' }}];\n}\nconst payload = data.data || data.result || data.message || data;\nlet reply = '';\nif (typeof payload === 'string') {\n  reply = payload;\n} else if (Array.isArray(payload)) {\n  reply = `Tìm thấy ${payload.length} kết quả.\\n` +\n    payload.slice(0, 15).map((r, i) => `${i+1}. ${JSON.stringify(r)}`).join('\\n');\n} else {\n  reply = JSON.stringify(payload, null, 2);\n}\nreturn [{ json: { reply, status: 'success', count: Array.isArray(payload) ? payload.length : null }}];"
