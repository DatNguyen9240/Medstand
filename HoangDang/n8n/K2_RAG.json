      "parameters": {
        "method": "POST",
        "url": "https://b83c89c5-9bd2-4175-8154-6b4205705cc5.us-west-1-0.aws.cloud.qdrant.io/collections/medstand-rag/points/search",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "api-key",
              "value": "eyJhbGciOiJKUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2NlcyM3OiJtln0.bCzPla_YDJWhugt_C0IM6FNa8YcrI00HGOPBwTe_JBQ"
            },
