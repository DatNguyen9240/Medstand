    },
    {
      "parameters": {
        "jsCode": "// KHỐI 3 — Nghiệp Vụ Cơ Bản\nconst raw = $input.item.json;\nconst body = raw.body || raw;\nconst headers = raw.headers || {};\n\nconst ApiCode = (body.ApiCode || '').trim();\nconst username = body.username || 'default';\nconst token = headers.authorization || body.token || 'Bearer empty';\nconst isConfirm = parseInt(body.isConfirm || '0', 10);\n\nlet params = {};\nif (typeof body.params === 'string') {\n  try { params = JSON.parse(body.params); } catch(e) { params = {}; }\n} else if (typeof body.params === 'object' && body.params !== null) {\n  params = body.params;\n}\n\nif (!params['@Username']) params['@Username'] = username;\n\nif (!ApiCode) {\n  return [{ json: { loi: true, message: 'Thiếu ApiCode. Cần truyền ApiCode và params dạng JSON object.' } }];\n}\n\nreturn [{ json: { ApiCode, username, token, isConfirm, params, hop_le: true } }];"
      },
