      ],
      "id": "0a795121-a52b-407d-8838-9620cd574aef",
      "name": "Gọi Backend API"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.item.json;\nconst ApiCode = $('Parse Input').item.json.ApiCode || '';\n\nif (data.error || data.status === 'error') {\n  return [{ json: {\n    ket_qua: `❌ Lỗi [${ApiCode}]: ${data.message || data.error || 'Lỗi không xác định'}`,\n    loi: true\n  }}];\n}\n\nconst payload = data.data || data.result || data.message || data;\nlet text = '';\n\nif (typeof payload === 'string') {\n  text = payload;\n} else if (Array.isArray(payload)) {\n  const total = payload.length;\n  if (total === 0) {\n    text = 'Không có dữ liệu.';\n  } else {\n    const keys = Object.keys(payload[0]).filter(k => !k.startsWith('_'));\n    text = `Tìm thấy ${total} kết quả:\\n\\n`;\n    text += `| STT | ${keys.join(' | ')} |\\n`;\n    text += `|---|${keys.map(() => '---').join('|')} |\\n`;\n    text += payload.slice(0, 20).map((row, i) => {\n      return `| ${i + 1} | ${keys.map(k => {\n        let val = row[k];\n        if (val === null || val === undefined) return '';\n        return String(val).replace(/\\|/g, '-');\n      }).join(' | ')} |`;\n    }).join('\\n');\n    if (total > 20) text += `\\n\\n... và ${total - 20} kết quả khác.`;\n  }\n} else {\n  text = JSON.stringify(payload, null, 2);\n}\n\nreturn [{ json: {\n  ket_qua: text || 'Không có dữ liệu.',\n  ApiCode,\n  so_ban_ghi: Array.isArray(payload) ? payload.length : null\n}}];"
      },
