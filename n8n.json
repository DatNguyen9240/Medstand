    {
      "parameters": {
        "promptType": "define",
        "text": "=Nhiệm vụ: Đọc câu hỏi của người dùng và phân loại thành ĐÚNG 1 MÃ ACTION (chữ thường) trong danh sách sau. TUYỆT ĐỐI CHỈ TRẢ VỀ MÃ ACTION, KHÔNG GIẢI THÍCH GÌ THÊM.\n\nDanh sách mã Action:\n1. 'quan_gia' : nhắc việc cá nhân, lịch làm việc chung.\n2. 'mat_than' : gợi ý nhập hàng định kỳ, đứt hàng.\n3. 'tuyen_ban_hang' : ghé thăm khách hàng nào hôm nay, lịch tuyến.\n4. 'cham_diem_kh' : phân loại khách hàng, chấm điểm, khách VIP, nguy cơ.\n5. 'moc_thuong' : mốc thưởng, tích lũy, tiến độ quà tặng.\n6. 'ceo_insights' : báo cáo tổng quan giám đốc, chiến lược xả hàng, đọng vốn.\n7. 'catalog' : tra cứu giá niêm yết, danh mục sản phẩm.\n8. 'goi_y_don_thuoc' : phân tích đơn thuốc, kê toa thay thế thuốc, kháng sinh.\n9. 'ai_google_sale' : triệu chứng bệnh, tư vấn y khoa (ho, sốt, đau...).\n10. 'chat_history' : xem lịch sử chat.\n11. 'greeting' : chào hỏi thông thường.\n12. 'ai_sale' : tồn kho, công nợ, doanh thu, doanh số, tra cứu đơn hàng, tạo đơn, thông báo, tài liệu, xem thông tin nhân viên, khách hàng chung chung.\n\nCâu hỏi từ người dùng: \"{{ $json.body?.text || '' }}\""
      },
      "id": "f93e3acb-f67e-44a5-ab1f-4ccf0c9180b5",
      "name": "AI Lễ Tân (Phân Loại)",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        -3360,
        6000
      ]
    },
    {
      "parameters": {
        "jsCode": "const webhookData = $('Webhook Mobile App').first()?.json || {};\nconst aiOutput = ($input.first()?.json?.text || '').toLowerCase();\n\n// 1. CHUẨN HÓA DATA ĐẦU VÀO\nlet body = { ...(webhookData.body || {}), ...(webhookData.query || {}) };\nbody.text = (body.text || body.query || '').trim();\nbody.username = body.username || 'guest';\n\n// 2. PHÂN LOẠI NHANH (FAST PATH)\nlet action = 'ai_sale'; \nconst validActions = ['ai_sale', 'quan_gia', 'mat_than', 'tuyen_ban_hang', 'cham_diem_kh', 'moc_thuong', 'ceo_insights', 'catalog', 'goi_y_don_thuoc', 'ai_google_sale', 'chat_history', 'greeting'];\n\n// Tìm action từ output của AI\nconst aiWords = aiOutput.replace(/[^a-z_]/g, ' ').split(/\\s+/);\nconst matchedAction = validActions.find(v => aiWords.includes(v));\nif (matchedAction) action = matchedAction;\n\n// 3. LOGIC CỨNG (OVERRIDE AI) - ƯU TIÊN ĐỘ CHÍNH XÁC\nfunction removeAccents(str) {\n  return str.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D');\n}\n\nconst cleanText = removeAccents(body.text.toLowerCase());\n\n// --- CÁC LUẬT ƯU TIÊN CAO --- \nif (body.image_url) {\n    action = 'goi_y_don_thuoc'; \n} \nelse if (/\\b(lich su|chat history|tin nhan)\\b/i.test(cleanText)) {\n    action = 'chat_history';\n}\nelse if (/^(alo|hi|hello|chao|xin chao|hi sếp)$/i.test(cleanText)) {\n    action = 'greeting';\n}\n// --- CÁC NGHIỆP VỤ CHUYÊN BIỆT (REGEX CHẶT CHẼ) --- \nelse if (/\\b(don thuoc|toa thuoc|goi y thuoc|thay the|khang sinh|amox|cefu|para|augmentin|klamentin)\\b/i.test(cleanText)) {\n    action = 'goi_y_don_thuoc';\n} \nelse if (/\\b(ho|sot|dau|viem|trieu chung|tu van thuoc|benh|cam cum|nhuc dau|dau bung)\\b/i.test(cleanText)) {\n    action = 'ai_google_sale';\n} \nelse if (/\\b(ceo|insight|tong quan|dong von|xa hang|can date|ban cham|khuyen mai|combo|chien luoc|phan tich|tap trung|nen ban gi|uu tien|ban gi hom nay)\\b/i.test(cleanText)) {\n    action = 'ceo_insights';\n} \nelse if (/\\b(moc thuong|tich luy|tien do|dat moc|thieu bao nhieu|chuong trinh thuong)\\b/i.test(cleanText)) {\n    action = 'moc_thuong';\n} \nelse if (/\\b(cham diem|rot nhom|vip|tiem nang|hang a|hang b|hang c|nguy co|phan loai kh)\\b/i.test(cleanText)) {\n    action = 'cham_diem_kh';\n} \nelse if (/\\b(tuyen|lich trinh|di dau|hom nay di|lich ghe|danh sach tuyen|lo trinh)\\b/i.test(cleanText)) {\n    action = 'tuyen_ban_hang';\n} \nelse if (/\\b(mat than|dut hang|nhap thêm|gợi ý nhập|cần nhập gì|het hang)\\b/i.test(cleanText)) {\n    action = 'mat_than';\n} \nelse if (/\\b(quan gia|nhac viec|lich lam viec|lich hen|cong viec)\\b/i.test(cleanText)) {\n    action = 'quan_gia';\n}\nelse if (/\\b(catalog|gia ban|thong tin thuoc|danh muc|gia niem yet|tim gia)\\b/i.test(cleanText)) {\n    action = 'catalog';\n}\n// --- CÁC LỆNH TỔNG HỢP (MEGA-ROUTER) --- \nelse if (/\\b(ton kho|cong no|doanh thu|doanh so|don hang|tao don|len don|nhan vien|khach hang|tai lieu|chinh sach|thong bao|ban chay)\\b/i.test(cleanText)) {\n    action = 'ai_sale';\n}\n\nbody.action = action;\n\n// 4. CHUẨN HÓA TOKEN VÀ SECURITY\nlet rawToken = webhookData.headers?.authorization || webhookData.headers?.Authorization || body.token || '';\nif (rawToken && !rawToken.toLowerCase().startsWith('bearer')) {\n    rawToken = 'Bearer ' + rawToken.trim();\n}\nbody.token = rawToken;\n\nbody._processed_at = new Date().toISOString();\n\nreturn [{ json: { body: body } }];"
      },
