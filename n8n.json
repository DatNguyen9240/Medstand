    {
      "parameters": {
        "jsCode": "const webhookData = $('Webhook Mobile App').first()?.json || {};\nconst aiOutput = ($input.first()?.json?.text || '').toLowerCase();\n\n// 1. CHUẨN HÓA DATA ĐẦU VÀO\nlet body = { ...(webhookData.body || {}), ...(webhookData.query || {}) };\nbody.text = (body.text || body.query || '').trim();\nbody.username = body.username || 'guest';\n\n// 2. PHÂN LOẠI NHANH (FAST PATH — từ AI output)\nlet action = 'ai_sale';\nconst validActions = ['ai_sale', 'goi_y_don_hang', 'quan_gia', 'mat_than', 'tuyen_ban_hang', 'cham_diem_kh', 'moc_thuong', 'ceo_insights', 'catalog', 'goi_y_don_thuoc', 'ai_google_sale', 'chat_history', 'greeting'];\nconst aiWords = aiOutput.replace(/[^a-z_]/g, ' ').split(/\\s+/);\nconst matchedAction = validActions.find(v => aiWords.includes(v));\nif (matchedAction) action = matchedAction;\n\n// 3. HELPER — bỏ dấu tiếng Việt\nfunction removeAccents(str) {\n  return str.normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D');\n}\nconst cleanText = removeAccents(body.text.toLowerCase());\n\n// 4. LOGIC CỨNG (OVERRIDE AI) — ƯU TIÊN CAO NHẤT\nif (body.image_url) {\n    action = 'goi_y_don_thuoc';\n}\nelse if (/\\b(lich su|chat history|tin nhan cu)\\b/.test(cleanText)) {\n    action = 'chat_history';\n}\nelse if (/^(alo|hi|hello|chao|xin chao|hi sep|good morning)$/.test(cleanText)) {\n    action = 'greeting';\n}\n// MODULE 7 — ĐƠN THUỐC / KHÁNG SINH (không dấu)\nelse if (/\\b(don thuoc|toa thuoc|goi y thuoc|thay the thuoc|khang sinh|amox|cefu|para|augmentin|klamentin|bromhexin|amoxicillin|paracetamol)\\b/.test(cleanText)) {\n    action = 'goi_y_don_thuoc';\n}\n// MODULE 5 — TRIỆU CHỨNG Y KHOA (không dấu)\nelse if (/\\b(thuoc ho|bi ho|ho lau|thuoc sot|bi sot|sot cao|dau dau|nhuc dau|dau bung|tieu chay|viem hong|cam cum|di ung|rat hong|nghet mui|kho tho|mat ngu|bo than kinh|xuong khop|tieu duong|huyet ap)\\b/.test(cleanText)) {\n    action = 'ai_google_sale';\n}\n// MODULE 6 — CEO INSIGHTS (chiến lược tổng, không phải khách cụ thể)\nelse if (/\\b(ceo|tong quan|dong von|xa hang|can date|ban cham kho|chien luoc kinh doanh|phan tich ton kho|khuyen mai gi|chien luoc)\\b/.test(cleanText)) {\n    action = 'ceo_insights';\n}\n// MODULE 4 — TÍCH LŨY / MỐC THƯỞNG\nelse if (/\\b(moc thuong|tich luy|tien do thuong|dat moc|thieu bao nhieu de dat|chuong trinh thuong|sap dat thuong|qua tang|con thieu)\\b/.test(cleanText)) {\n    action = 'moc_thuong';\n}\n// MODULE 3 — CHẤM ĐIỂM KH\nelse if (/\\b(cham diem|phan loai khach|rot nhom|nhom a|nhom b|nhom c|hang a|hang b|hang c|nguy co roi bo|sap nghi mua|khach vip)\\b/.test(cleanText)) {\n    action = 'cham_diem_kh';\n}\n// MODULE 2 — TUYẾN BÁN HÀNG\nelse if (/\\b(tuyen hom nay|lich ghe|ghe khach nao|khach nao nen ghe|danh sach tuyen|lo trinh hom nay|lau chua ghe|lau chua mua)\\b/.test(cleanText)) {\n    action = 'tuyen_ban_hang';\n}\n// MODULE 1b — MẠT THẦN (nhập hàng định kỳ — không dấu)\nelse if (/\\b(mat than|dut hang|nhap them|goi y nhap|can nhap gi|sap het hang|can dat hang)\\b/.test(cleanText)) {\n    action = 'mat_than';\n}\n// MODULE 1a — GỢI Ý ĐƠN HÀNG cho khách / bán chạy (không dấu)\nelse if (/\\b(goi y don hang|nen ban gi cho|khach nen mua gi|ban chay nhat chi nhanh|nen tap trung ban gi|top hang ban|sp uu tien|don hang goi y)\\b/.test(cleanText)) {\n    action = 'goi_y_don_hang';\n}\n// ADMIN / CATALOG\nelse if (/\\b(quan gia|nhac viec|lich lam viec|lich hen ca nhan|cong viec ca nhan)\\b/.test(cleanText)) {\n    action = 'quan_gia';\n}\nelse if (/\\b(catalog|gia ban|thong tin thuoc|danh muc sp|gia niem yet|tim gia|gia bao nhieu)\\b/.test(cleanText)) {\n    action = 'catalog';\n}\n// TỔNG HỢP — AI SALE\nelse if (/\\b(ton kho|cong no|doanh thu|doanh so|don hang|tao don|len don|nhan vien|tai lieu|chinh sach|thong bao|ban chay chung|xem khach)\\b/.test(cleanText)) {\n    action = 'ai_sale';\n}\n\nbody.action = action;\n\n// 5. TRÍCH XUẤT THAM SỐ SQL\n// A. ObjectID — Mã khách hàng\nbody.objectID = body.object_id || body.objectid || body.khach_hang || body.ma_kh || '';\nif (!body.objectID) {\n  const objMatch = body.text.match(/\\b([A-Z]{1,3}\\d{3,6})\\b/i);\n  if (objMatch) body.objectID = objMatch[1].toUpperCase();\n}\n\n// B. SearchKey — Từ khóa triệu chứng (Module 5)\nbody.searchKey = body.search_key || body.trieu_chung || body.searchkey || '';\nif (!body.searchKey && action === 'ai_google_sale') {\n  const symptomMap = [\n    ['thuoc ho|bi ho|ho lau', 'ho'], ['thuoc sot|bi sot|sot cao', 'sot'],\n    ['dau dau|nhuc dau', 'dau dau'], ['dau bung', 'dau bung'],\n    ['tieu chay', 'tieu chay'], ['viem hong', 'viem hong'],\n    ['cam cum', 'cam cum'], ['di ung', 'di ung'],\n    ['kho tho', 'kho tho'], ['mat ngu', 'mat ngu'],\n    ['bo than kinh', 'bo than kinh'], ['xuong khop', 'xuong khop'],\n    ['tieu duong', 'tieu duong'], ['huyet ap', 'huyet ap']\n  ];\n  for (const [pattern, val] of symptomMap) {\n    if (new RegExp(pattern).test(cleanText)) { body.searchKey = val; break; }\n  }\n}\n\n// C. NhomFilter — Nhóm A/B/C (Module 3)\nbody.nhomFilter = body.nhom_filter || body.nhomfilter || '';\nif (!body.nhomFilter && action === 'cham_diem_kh') {\n  if (/\\b(vip|nhom a|hang a|khach a|doanh so cao nhat)\\b/.test(cleanText)) body.nhomFilter = 'A';\n  else if (/\\b(nhom b|hang b|on dinh|tiem nang)\\b/.test(cleanText)) body.nhomFilter = 'B';\n  else if (/\\b(nguy co|nhom c|hang c|sap nghi|lau chua mua|mat khach)\\b/.test(cleanText)) body.nhomFilter = 'C';\n}\n\n// D. medicineKeyword — Tên thuốc từ đơn (Module 7)\nbody.medicineKeyword = body.keyword || body.ten_thuoc || body.thuoc || '';\n\n// E. TopN — Số kết quả tối đa\nbody.topN = parseInt(body.top_n || body.topn || body.so_luong || '10', 10) || 10;\n\n// F. MucTieu — Mức tích lũy (Module 4)\nbody.mucTieu = parseFloat(body.muc_tieu || body.muctieu || '10000000') || 10000000;\n\n// G. SoNgayVangMat — Ngưỡng cảnh báo (Module 2)\nbody.soNgayVangMat = parseInt(body.so_ngay || body.ngay_vang_mat || '45', 10) || 45;\n\n// 6. SECURITY & METADATA\nlet rawToken = webhookData.headers?.authorization || webhookData.headers?.Authorization || body.token || '';\nif (rawToken && !rawToken.toLowerCase().startsWith('bearer')) {\n    rawToken = 'Bearer ' + rawToken.trim();\n}\nbody.token = rawToken;\nbody._processed_at = new Date().toISOString();\n\nreturn [{ json: { body: body } }];"
      },
