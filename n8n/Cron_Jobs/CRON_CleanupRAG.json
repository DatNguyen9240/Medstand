{
  "name": "K6 · RAG Lifecycle Cleanup",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "cron-trigger-midnight",
      "name": "Midnight Trigger (00:00)"
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { nowEpoch: Math.floor(Date.now() / 1000), requestedAt: new Date().toISOString() } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        0
      ],
      "id": "prepare-cleanup-vars",
      "name": "Prepare Cleanup Variables"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.QDRANT_URL ? $env.QDRANT_URL : 'http://127.0.0.1:6333' }}/collections/medstand-policies/points/delete?wait=true",
        "sendBody": true,
        "options": {},
        "specifyBody": "json",
        "jsonBody": "={ \"filter\": { \"must\": [ { \"key\": \"metadata.effectiveToEpoch\", \"range\": { \"lte\": {{ $json.nowEpoch }} } } ] } }"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        400,
        0
      ],
      "id": "qdrant-delete-expired",
      "name": "Qdrant HTTP Request (Drop Expired)"
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { status: 'success', code: 'RAG_LIFECYCLE_CLEANUP', executedAt: new Date().toISOString(), qdrant: $input.first().json } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        0
      ],
      "id": "save-deletion-logs",
      "name": "Blackbox Logging (Save logs)"
    }
  ],
  "connections": {
    "Midnight Trigger (00:00)": {
      "main": [
        [
          {
            "node": "Prepare Cleanup Variables",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Cleanup Variables": {
      "main": [
        [
          {
            "node": "Qdrant HTTP Request (Drop Expired)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Qdrant HTTP Request (Drop Expired)": {
      "main": [
        [
          {
            "node": "Blackbox Logging (Save logs)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "pinData": {}
}
