      "id": "http-execute",
      "name": "MS SQL Execute",
      "credentials": {
        "microsoftSql": {
          "id": "",
          "name": "MS SQL account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (!items || items.length === 0) {\n  return [{ json: { reply: 'Khong tim thay du lieu', status: 'success', count: 0, data: [], uiTemplate: uiTemplate } }];\n}\n\nconst JSON_KEY = 'JSON_F52E2B61-18A1-11d1-B105-00805F49916B';\nlet payload = items.map(i => i.json);\n\n// 0. Extract Metadata\nlet uiTemplate = 'DEFAULT';\nconst metaIdx = payload.findIndex(r => r.Metadata_UiTemplate !== undefined);\nif (metaIdx !== -1) {\n  uiTemplate = payload[metaIdx].Metadata_UiTemplate;\n  payload.splice(metaIdx, 1);\n}\n\n// Xu ly SQL FOR JSON PATH output (khi SP khong tim thay trong API_Definition)\n// N8N MS SQL tra ve [{JSON_F52E...: '[{\"code\":2,\"msg\":\"...\"}]'}]\nif (payload.length === 1 && payload[0][JSON_KEY] !== undefined) {\n  try {\n    const inner = JSON.parse(payload[0][JSON_KEY]);\n    if (Array.isArray(inner) && inner.length > 0) {\n      if (inner[0].code === 1 || inner[0].code === 2) {\n        return [{ json: { reply: inner[0].msg || 'ApiCode chua duoc dang ky trong he thong', status: 'error', data: [], uiTemplate: uiTemplate } }];\n      }\n      payload = inner;\n    }\n  } catch(e) {\n    return [{ json: { reply: 'Loi xu ly ket qua SQL', status: 'error', data: [], uiTemplate: uiTemplate } }];\n  }\n  if (payload.length === 1 && payload[0][JSON_KEY] !== undefined) {\n    return [{ json: { reply: 'Khong tim thay API phu hop', status: 'error', data: [], uiTemplate: uiTemplate } }];\n  }\n}\n\n// Kiem tra loi don gian {code, msg}\nif (payload.length === 1 && (payload[0].code === 1 || payload[0].code === 2 || payload[0].error)) {\n  return [{ json: { reply: payload[0].msg || payload[0].error || 'Loi khong xac dinh', status: 'error', data: [], uiTemplate: uiTemplate } }];\n}\n\n// Loc bo cac row con JSON_KEY\npayload = payload.filter(r => r[JSON_KEY] === undefined);\n\nif (payload.length === 0) {\n  return [{ json: { reply: 'Khong tim thay du lieu', status: 'success', count: 0, data: [], uiTemplate: uiTemplate } }];\n}\n\nreturn [{ json: { \n  reply: 'Tim thay ' + payload.length + ' ket qua.', \n  status: 'success', \n  count: payload.length, \n  data: payload, uiTemplate: uiTemplate \n} }];"
      },
