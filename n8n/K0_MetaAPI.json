    {
      "parameters": {
        "jsCode": "const inputJson = $json || {};\nconst headers = inputJson.headers || {};\nconst method = inputJson.method || headers['x-forwarded-method'] || 'POST';\nconst body = inputJson.body || {};\nlet apiCode = body.ApiCode || body.StoredProcedure || '';\n\nif (!headers.authorization && headers.cookie) {\n  const m = headers.cookie.match(/(?:^|; )auth_token=([^;]+)/);\n  if (m) headers.authorization = 'Bearer ' + m[1];\n}\n\nif (!/^@[a-zA-Z0-9_]+$/.test(apiCode)) {\n  apiCode = '@invalid_code';\n}\n\nconst params = body.params || {};\nconst paramsSafeStr = JSON.stringify(params).replace(/'/g, \"''\");\n\nreturn [{ json: { ...inputJson, headers: headers, body: {...body, ApiCode: apiCode}, _paramsSafeStr: paramsSafeStr, _method: method.toUpperCase() } }];"
      },
