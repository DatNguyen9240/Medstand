      "id": "cors-ds",
      "name": "CORS OK (DataSource)"
    },
    {
      "parameters": {
        "jsCode": "// Build DataSource SQL\nconst dsNode = $('Check Method DataSource').first().json;\nlet dsVal = dsNode.body.DataSourceValueSafe || '';\nconst searchKey = dsNode.body.SearchKeySafe || '';\nconst username = dsNode.body.username || '';\n\nif (!dsVal) return [{ json: { query: \"SELECT 1 AS code, 'Empty DataSource' AS msg FOR JSON PATH;\" } }];\n\n// Phân tách chuỗi pipeline: \"@sp_name|@p1=v1\"\nconst parts = dsVal.split('|');\nlet spName = parts[0].trim();\n\n// Mapping Shorthands\nconst mapper = {\n  '@danh_muc': 'API_DanhMuc_Core_AI',\n  '@tra_cuu_san_pham': 'API_TraCuuSanPham_AI',\n  '@san_pham': 'API_TraCuuSanPham_AI'\n};\nif (mapper[spName.toLowerCase()]) spName = mapper[spName.toLowerCase()];\n\n// Kiểm tra tính hợp lệ của SP (Cho phép API_, sp_ hoặc @)\nif (!(/^(API_|sp_|@)/i.test(spName))) {\n  return [{ json: { query: \"SELECT 1 AS code, 'Invalid DataSource SP Name: ' + spName AS msg FOR JSON PATH;\" } }];\n}\n\nlet query = `EXEC ${spName.replace(/[^a-zA-Z0-9_@]/g, '')}`;\nlet params = [];\n\nlet usedSearchKey = false;\n\n// Xử lý các tham số từ pipeline\nfor (let i = 1; i < parts.length; i++) {\n  const p = parts[i].split('=');\n  if (p.length === 2) {\n    const pKey = p[0].trim().replace(/[^a-zA-Z0-9_@]/g, '');\n    let pVal = p[1].trim();\n    // Thay thế biến {q} bằng từ khóa tìm kiếm n8n nhận được\n    if (pVal.includes('{q}')) {\n      pVal = pVal.replace('{q}', searchKey);\n      usedSearchKey = true;\n    }\n    if (pVal.includes('{username}')) {\n      pVal = pVal.replace('{username}', username);\n    }\n    params.push(`${pKey} = N'${pVal}'`);\n  }\n}\n\n// Bơm mặc định @timkiem nếu chưa dùng {q}\nif (searchKey && !usedSearchKey) {\n  params.push(`@timkiem = N'${searchKey}'`);\n}\n\nif (params.length) query += ' ' + params.join(', ');\nquery += ';';\n\nreturn [{ json: { query } }];"
