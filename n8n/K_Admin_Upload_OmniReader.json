{
  "name": "K_Admin_Upload_OmniReader",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "admin-upload",
        "responseMode": "lastNode",
        "options": {
          "responseHeaders": {
            "entries": [
              { "name": "Access-Control-Allow-Origin", "value": "*" },
              { "name": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" },
              { "name": "Access-Control-Allow-Methods", "value": "POST, GET, OPTIONS" }
            ]
          }
        }
      },
      "id": "webhook-admin-upload",
      "name": "Webhook Admin Upload",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [ 0, 300 ]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || {};\nconst headers = $input.first().json.headers || {};\nlet isAdmin = false;\nif (body.role && body.role.toLowerCase() === 'admin') isAdmin = true;\n\nlet hasFile = false;\nlet mime = '';\nlet ext = '';\nif ($input.first().binary && $input.first().binary.file) {\n    hasFile = true;\n    mime = ($input.first().binary.file.mimeType || '').toLowerCase();\n    ext = ($input.first().binary.file.fileExtension || '').toLowerCase();\n}\n\nreturn [{\n    json: {\n        passes: isAdmin,\n        hasFile: hasFile,\n        expiryDate: body.expiryDate || 'never',\n        title: body.title || 'Untitled Document',\n        mime: mime,\n        ext: ext\n    },\n    binary: $input.first().binary\n}];"
      },
      "id": "check-auth-format",
      "name": "Check Auth & Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 200, 300 ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            { "value1": "={{ $json.passes }}", "value2": true },
            { "value1": "={{ $json.hasFile }}", "value2": true }
          ]
        }
      },
      "id": "if-admin-has-file",
      "name": "If Admin & Has File",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [ 400, 300 ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { status: 'error', message: 'Access Denied or No File Uploaded.' } }];"
      },
      "id": "respond-error",
      "name": "Respond Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 600, 500 ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{ $json.mime }}", "operation": "contains", "value2": "excel" },
            { "value1": "={{ $json.mime }}", "operation": "contains", "value2": "spreadsheet" },
            { "value1": "={{ $json.ext }}", "operation": "equal", "value2": "xlsx" },
            { "value1": "={{ $json.ext }}", "operation": "equal", "value2": "xls" },
            { "value1": "={{ $json.ext }}", "operation": "equal", "value2": "csv" }
          ]
        },
        "combineConditions": "ANY"
      },
      "id": "route-by-type",
      "name": "Route by File Type",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [ 600, 200 ]
    },
    {
      "parameters": {
        "binaryPropertyName": "file",
        "options": {
          "headerRow": false,
          "readAsString": true
        }
      },
      "id": "spreadsheet-reader",
      "name": "Spreadsheet Reader",
      "type": "n8n-nodes-base.spreadsheetFile",
      "typeVersion": 1,
      "position": [ 850, -50 ]
    },
    {
      "parameters": {
        "jsCode": "let fullText = '';\nfor (const item of $input.all()) {\n  if (item.json) {\n    const line = Object.values(item.json).filter(v => v !== null && v !== undefined && String(v).trim() !== '').join(' | ');\n    if (line.trim()) fullText += line + '\\n';\n  }\n}\nconst authNode = $('Check Auth & Format').first().json;\nconst title = authNode.title || 'Untitled';\nconst expiryDate = authNode.expiryDate || 'never';\nconst textBuffer = Buffer.from(fullText, 'utf8');\nreturn [{\n  json: { title: title, expiryDate: expiryDate },\n  binary: { text_file: { data: textBuffer.toString('base64'), mimeType: 'text/plain', fileName: 'omni_unified_knowledge.txt' } }\n}];"
      },
      "id": "flatten-text",
      "name": "Flatten ALL to Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 1100, -50 ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            { "value1": "={{ $json.mime }}", "operation": "contains", "value2": "image" },
            { "value1": "={{ $json.ext }}", "operation": "equal", "value2": "png" },
            { "value1": "={{ $json.ext }}", "operation": "equal", "value2": "jpg" },
            { "value1": "={{ $json.ext }}", "operation": "equal", "value2": "jpeg" }
          ]
        },
        "combineConditions": "ANY"
      },
      "id": "if-image-type",
      "name": "If Image Type",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [ 850, 400 ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst authNode = $('Check Auth & Format').first().json;\nconst title = authNode.title || 'Untitled';\nconst expiryDate = authNode.expiryDate || 'never';\nreturn [{\n  json: { title: title, expiryDate: expiryDate },\n  binary: { text_file: item.binary.file }\n}];"
      },
      "id": "pass-to-langchain",
      "name": "Pass PDF/Word to Langchain",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 1100, 550 ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\n// FIX FOR FILESYSTEM BINARY STORE\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'file');\nconst base64Data = buffer.toString('base64');\nconst mimeType = item.binary.file.mimeType || 'image/png';\n\nconst systemPrompt = `Bạn là công cụ trích xuất văn bản (OCR) siêu việt. Hãy trích xuất chính xác 100% các chữ có trong ảnh. Tuyệt đối không tự tóm tắt, không tự sáng tạo nội dung, không giải thích hình ảnh. Giả định bạn đang làm việc với tờ rơi phòng khám/sản phẩm, hãy phân tích bố cục và trả về dữ liệu dưới định dạng JSON chứa 2 field:\\n1. \\\"product_name\\\": Tên sản phẩm chính.\\n2. \\\"content\\\": Toàn bộ nội dung tờ rơi.`;\n\nreturn [{ json: {\n  model: \"openai/gpt-4o-mini\",\n  response_format: { type: \"json_object\" },\n  messages: [\n    { role: \"system\", content: systemPrompt },\n    { role: \"user\", content: [\n        { type: \"text\", text: \"Hãy trích xuất thông tin dưới dạng JSON:\" },\n        { type: \"image_url\", image_url: { url: 'data:' + mimeType + ';base64,' + base64Data } }\n    ] }\n  ]\n}}];"
      },
      "id": "prep-vision",
      "name": "Prep Vision Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 1100, 250 ]
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "seconds"
      },
      "id": "wait-node",
      "name": "Wait (Anti-RateLimit)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [ 1330, 100 ]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "method": "POST",
        "url": "={{ $env.LLM_API_BASE ? $env.LLM_API_BASE : 'https://openrouter.ai/api/v1' }}/chat/completions",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}"
      },
      "id": "vision-ocr",
      "name": "OpenAI Vision OCR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [ 1330, 250 ],
      "credentials": { "openAiApi": { "id": "NUWWHWYzGHV6GY0g", "name": "OpenAi account" } }
    },
    {
      "parameters": {
        "jsCode": "const text = $input.first().json.choices[0].message.content;\nlet parsed = {};\ntry {\n  parsed = JSON.parse(text);\n} catch(e) {\n  parsed = { product_name: 'Unknown', content: text };\n}\nconst productName = parsed.product_name || 'Thông tin hình ảnh';\nconst rawContent = parsed.content || text;\nconst textBuffer = Buffer.from(`[ẢNH SẢN PHẨM: ${productName}]\\n\\n` + rawContent, 'utf8');\n\nconst authNode = $('Check Auth & Format').first().json;\nconst expiryDate = authNode.expiryDate || 'never';\n\nreturn [{\n  json: { title: productName, expiryDate: expiryDate, source_type: 'image_poster' },\n  binary: { text_file: { data: textBuffer.toString('base64'), mimeType: 'text/plain', fileName: 'ocr_extracted.txt' } }\n}];"
      },
      "id": "parse-ocr",
      "name": "Parse OCR & Inject",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 1550, 250 ]
    },
    {
      "parameters": { "mode": "insert", "qdrantCollection": "medstand-policies", "options": {} },
      "id": "qdrant-vector-store",
      "name": "Qdrant Vector Store",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1,
      "position": [ 1850, 200 ]
    },
    {
      "parameters": { "dataType": "binary", "binaryPropertyName": "text_file", "options": { "metadata": "={\n  \"expiryDate\": \"{{ $json.expiryDate }}\",\n  \"title\": \"{{ $json.title }}\",\n  \"source_type\": \"{{ $json.source_type || 'document' }}\"\n}" } },
      "id": "document-loader",
      "name": "Default Data Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1,
      "position": [ 1650, 450 ]
    },
    {
      "parameters": { "model": "text-embedding-3-small", "options": {} },
      "id": "openai-embeddings",
      "name": "OpenAI Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1,
      "position": [ 1850, 450 ]
    },
    {
      "parameters": { "chunkSize": 1000, "chunkOverlap": 100 },
      "id": "text-splitter",
      "name": "Text Splitter",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [ 2000, 550 ]
    },
    {
      "parameters": { "jsCode": "return [{ json: { status: 'success', message: 'Tài liệu đã được bóc tách bằng OmniReader thành công' } }];" },
      "id": "respond-success",
      "name": "Respond Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 2100, 200 ]
    }
  ],
  "connections": {
    "Webhook Admin Upload": { "main": [ [ { "node": "Check Auth & Format", "type": "main", "index": 0 } ] ] },
    "Check Auth & Format": { "main": [ [ { "node": "If Admin & Has File", "type": "main", "index": 0 } ] ] },
    "If Admin & Has File": { "main": [ [ { "node": "Route by File Type", "type": "main", "index": 0 } ], [ { "node": "Respond Error", "type": "main", "index": 0 } ] ] },
    "Route by File Type": { "main": [ [ { "node": "Spreadsheet Reader", "type": "main", "index": 0 } ], [ { "node": "If Image Type", "type": "main", "index": 0 } ] ] },
    "Spreadsheet Reader": { "main": [ [ { "node": "Flatten ALL to Text", "type": "main", "index": 0 } ] ] },
    "If Image Type": { "main": [ [ { "node": "Prep Vision Body", "type": "main", "index": 0 } ], [ { "node": "Pass PDF/Word to Langchain", "type": "main", "index": 0 } ] ] },
    "Prep Vision Body": { "main": [ [ { "node": "Wait (Anti-RateLimit)", "type": "main", "index": 0 } ] ] },
    "Wait (Anti-RateLimit)": { "main": [ [ { "node": "OpenAI Vision OCR", "type": "main", "index": 0 } ] ] },
    "OpenAI Vision OCR": { "main": [ [ { "node": "Parse OCR & Inject", "type": "main", "index": 0 } ] ] },
    "Parse OCR & Inject": { "main": [ [ { "node": "Qdrant Vector Store", "type": "main", "index": 0 } ] ] },
    "Pass PDF/Word to Langchain": { "main": [ [ { "node": "Qdrant Vector Store", "type": "main", "index": 0 } ] ] },
    "Flatten ALL to Text": { "main": [ [ { "node": "Qdrant Vector Store", "type": "main", "index": 0 } ] ] },
    "Qdrant Vector Store": { "main": [ [ { "node": "Respond Success", "type": "main", "index": 0 } ] ] },
    "Default Data Loader": { "ai_document": [ [ { "node": "Qdrant Vector Store", "type": "ai_document", "index": 0 } ] ] },
    "OpenAI Embeddings": { "ai_embedding": [ [ { "node": "Qdrant Vector Store", "type": "ai_embedding", "index": 0 } ] ] },
    "Text Splitter": { "ai_textSplitter": [ [ { "node": "Default Data Loader", "type": "ai_textSplitter", "index": 0 } ] ] }
  },
  "settings": {}
}
