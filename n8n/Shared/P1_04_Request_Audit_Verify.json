        "operation": "executeQuery",
        "query": "DECLARE @AuditReader VARCHAR(50);\nSELECT TOP (1) @AuditReader = UserName\nFROM dbo.SY_User\nWHERE UPPER(ISNULL(UserGroupID, '')) IN ('ADMIN', 'SECURITY', 'QA')\n  AND COALESCE(Disable, 0) = 0\nORDER BY CASE UPPER(UserGroupID) WHEN 'QA' THEN 1 WHEN 'SECURITY' THEN 2 ELSE 3 END, UserName;\nIF @AuditReader IS NULL THROW 51242, 'No active Security/QA/Admin audit reader exists.', 1;\nEXEC dbo.API_ReadRequestAudit_AI @Username = @AuditReader, @TopN = 100;"
