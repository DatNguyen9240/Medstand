        "jsCode": "const body = $json.body || $json || {};\nconst ticket = String(body.ticket || '').trim().toLowerCase();\nreturn [{ json: {\n  ticket,\n  valid: /^telegram_[0-9a-f]{64}$/.test(ticket)\n} }];"
      },
