{
  "name": "Đại Não AI DEMO (Low-Code Architecture)",
  "nodes": [
    {
      "parameters": {
        "path": "hook-ai-dainao",
        "responseMode": "lastNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [0, 0],
      "id": "node-webhook",
      "name": "Webhook"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.text }}",
        "messages": {
          "messageValues": [
            {
              "message": "Bạn là AI Sale. Nếu khách hàng muốn tra cứu dữ liệu hoặc ra lệnh hệ thống, đừng tự trả lời mà hãy GỌI CÔNG CỤ Tool_TraCuu.\nBạn phải dùng Tool_TraCuu để lấy thông tin thực tế trước.",
              "role": "system"
            }
          ]
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [250, 0],
      "id": "node-agent",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [200, 250],
      "id": "node-model",
      "name": "OpenAI Chat Model"
    },
    {
      "parameters": {
        "sessionId": "={{ $json.body.username || 'default_user' }}",
        "contextWindowLength": 10
      },
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.2,
      "position": [350, 250],
      "id": "node-memory",
      "name": "Window Buffer Memory"
    },
    {
      "parameters": {
        "name": "Tool_TraCuu_HanhDong",
        "description": "Gọi công cụ này khi khách hàng yêu cầu TRẢ LỜI CÁC THÔNG TIN NHƯ: Tồn kho, Công Nợ, Hóa đơn, Doanh số, Danh mục. Hoặc yêu cầu: Thêm mới, tạo mới.\n\nTham số cần cung cấp:\n- loai_tra_cuu: (ton_kho, cong_no, doanh_so, tao_don, ...)\n- tu_khoa: (Từ khóa người dùng muốn tìm mốc thời gian hoặc tên vật tư)",
        "method": "POST",
        "url": "http://localhost:8000/api/chatbot-action",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n \"loai_tra_cuu\": \"{{$parameter.loai_tra_cuu}}\",\n \"tu_khoa\": \"{{$parameter.tu_khoa}}\"\n}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $('Webhook').item.json.headers.authorization || $('Webhook').item.json.body.token || 'Bearer empty' }}"
            }
          ]
        }
      },
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [500, 250],
      "id": "node-tool",
      "name": "HTTP Request Tool"
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Window Buffer Memory": {
      "ai_memory": [
        [
          {
            "node": "AI Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request Tool": {
      "ai_tool": [
        [
          {
            "node": "AI Agent",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    }
  }
}
