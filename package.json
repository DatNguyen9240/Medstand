{
  "name": "medstand-frontend",
  "version": "1.0.0",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node scripts/build.js",
    "verify:git-hygiene": "node scripts/verify_git_hygiene.js",
    "telegram:preflight": "node scripts/preflight_telegram_pilot.js",
    "telegram:schema:preflight": "node scripts/configure_telegram_uat_links.js --schema-only",
    "telegram:schema:apply": "node scripts/configure_telegram_uat_links.js --schema-only --apply",
    "telegram:db:verify": "node scripts/verify_telegram_pilot_db.js",
    "telegram:chat:smoke": "node scripts/smoke_telegram_chatbot_queries.js --apply",
    "telegram:draft:uat": "node scripts/verify_telegram_order_draft_ai.js",
    "telegram:notification:uat": "node scripts/verify_telegram_notification_dispatch_ai.js",
    "telegram:notification:smoke": "node scripts/send_telegram_notification_smoke.js --apply",
    "telegram:channel:verify": "node scripts/telegram_system_announcement.js",
    "telegram:channel:publish": "node scripts/telegram_system_announcement.js --publish --apply",
    "telegram:self-link:uat": "node scripts/verify_telegram_self_link_ai.js",
