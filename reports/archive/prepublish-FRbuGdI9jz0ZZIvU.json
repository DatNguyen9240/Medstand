[{"updatedAt":"2026-07-13T09:50:04.642Z","createdAt":"2026-04-26T16:18:26.552Z","id":"FRbuGdI9jz0ZZIvU","name":"K0-A · List Active APIs","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"api-list-active","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2,"position":[0,0],"id":"ffafae02-e722-45fa-859c-2d6133c59ebb","name":"Webhook ListActive","webhookId":"list-active-001"},{"parameters":{"jsCode":"const inputJson = $json || {};\nconst headers = inputJson.headers || {};\nconst body = inputJson.body || {};\nconst method = inputJson.method || headers['x-forwarded-method'] || 'POST';\n\nif (!headers.authorization && headers.cookie) {\n  const m = headers.cookie.match(/(?:^|; )auth_token=([^;]+)/);\n  if (m) headers.authorization = 'Bearer ' + m[1];\n}\n\n// Lấy danh tính từ Bearer token, không tin username do client tự gửi.\nlet username = '';\ntry {\n  const authHeader = headers.authorization || headers.Authorization || '';\n  const match = authHeader.match(/Bearer\\s+(.+)/i);\n  const token = match ? match[1].trim() : '';\n  if (token.includes('.')) {\n    const payloadPart = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');\n    const padding = (4 - payloadPart.length % 4) % 4;\n    const payload = JSON.parse(Buffer.from(payloadPart + '='.repeat(padding), 'base64').toString('utf8'));\n    username = payload.username || payload.Username || payload.UserName || payload.sub || '';\n  }\n} catch (error) {\n  username = '';\n}\n\nconst usernameSafe = String(username).replace(/'/g, \"''\").slice(0, 50);\nconst searchKeySafe = String(body.SearchKey || '').replace(/'/g, \"''\").slice(0, 100);\n\nreturn [{ json: {\n  ...inputJson,\n  headers,\n  body,\n  _usernameSafe: usernameSafe,\n  _searchKeySafe: searchKeySafe,\n  _method: method.toUpperCase()\n} }];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[272,0],"id":"5a16e5df-10ce-48f1-8708-c9fda53ca41f","name":"Check Method ListActive"},{"parameters":{"conditions":{"options":{"caseSensitive":false,"leftValue":"","typeValidation":"strict"},"conditions":[{"leftValue":"={{ $json._method }}","rightValue":"OPTIONS","operator":{"type":"string","operation":"equals"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion":2.2,"position":[528,0],"id":"1630fa0b-eeb2-40a3-a35a-8ef0c7cc9141","name":"Is OPTIONS? (ListActive)"},{"parameters":{"respondWith":"json","responseBody":"{}","options":{"responseCode":200,"responseHeaders":{"entries":[{"name":"Access-Control-Allow-Origin","value":"*"},{"name":"Access-Control-Allow-Methods","value":"GET, POST, OPTIONS"},{"name":"Access-Control-Allow-Headers","value":"Content-Type, Authorization, x-api-key"}]}}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[784,0],"id":"67eb2832-268e-4578-b23c-346cbaaa0292","name":"CORS OK (ListActive)"},{"parameters":{"operation":"executeQuery","query":"={{ \"EXEC dbo.API_ListActive @Username = N'\" + $json._usernameSafe + \"', @SearchKey = N'\" + $json._searchKeySafe + \"';\" }}"},"type":"n8n-nodes-base.microsoftSql","typeVersion":1,"position":[1040,0],"id":"da31c701-31f8-47ca-832a-69d5857e8744","name":"MS SQL API_ListActive","credentials":{"microsoftSql":{"id":"TpdxwsQAMalt6YK3","name":"Microsoft SQL account"}}},{"parameters":{"jsCode":"const items = $input.all();\nreturn [{ json: { records: items.map(i => i.json) } }];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1312,0],"id":"c0e9964d-00c5-43dc-9076-a906b4db5190","name":"Format ListActive Response"},{"parameters":{"respondWith":"json","responseBody":"={{ JSON.stringify($json.records) }}","options":{"responseCode":200,"responseHeaders":{"entries":[{"name":"Access-Control-Allow-Origin","value":"*"},{"name":"Access-Control-Allow-Headers","value":"Content-Type, Authorization, x-api-key"}]}}},"type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[1568,0],"id":"84dc41c6-7eb1-4330-95b3-a702c20ab7