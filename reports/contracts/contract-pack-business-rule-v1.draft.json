{
  "contractVersion": "1.0.0-draft",
  "status": "FROZEN_FOR_IMPLEMENTATION",
  "checksumAlgorithm": "SHA-256",
  "checksumScope": "canonical JSON payload with checksum omitted",
  "checksum": "ad40f0d66b6eb0033cc9b0295389657c4a1d3d4047bcf465db71f34bbad791ab",
  "sourceBaselineCommit": "8e4b5da7a0d3f820374692c65d39c8d8350d374d",
  "gate0ArtifactCommit": "PENDING_COORDINATOR_COMMIT",
  "ruleVersion": "BR-V1-DRAFT",
  "nullableSemantics": {
    "null": "unknown_or_not_available; never coerce to zero",
    "emptyArray": "no records for the requested scope/filter",
    "emptyString": "unknown unless the field contract explicitly defines empty as meaningful",
    "zero": "valid numeric zero when returned by the API",
    "false": "valid boolean false when returned by the API"
  },
  "errorTaxonomy": {
    "NO_DATA": "Request is valid but no record satisfies the filter and scope.",
    "OUT_OF_SCOPE": "Data exists but is not visible to the authenticated role/scope.",
    "VALIDATION_ERROR": "Input is missing or invalid; business SQL must not execute.",
    "SYSTEM_ERROR": "Gateway, workflow, database or unexpected system failure; do not expose SQL/token details."
  },
  "commonEnvelope": {
    "required": ["ApiCode", "contractVersion", "requestId", "status", "data", "metadata"],
    "fields": {
      "ApiCode": { "type": "string", "pattern": "^@" },
      "contractVersion": { "type": "string" },
      "requestId": { "type": "string", "pattern": "^req-" },
      "status": { "enum": ["SUCCESS", "NO_DATA", "OUT_OF_SCOPE", "VALIDATION_ERROR", "SYSTEM_ERROR"] },
      "errorCode": { "type": ["string", "null"] },
      "data": { "type": "array" },
      "metadata": {
        "type": "object",
        "fields": ["ruleVersion", "source", "dataWindow", "updatedAt", "scope", "freshness"]
      }
    }
  },
  "apis": [
